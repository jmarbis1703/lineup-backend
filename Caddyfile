# Automatic HTTPS via Let's Encrypt — no tls block needed.
# Caddy obtains certificates automatically for every named site address.

lineupmarkets.com {
    reverse_proxy nextjs:3000

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    log {
        output stdout
        format json
    }
}

www.lineupmarkets.com {
    redir https://lineupmarkets.com{uri} permanent
}

api.lineupmarkets.com {
    # WebSocket support
    @websocket {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    handle @websocket {
        reverse_proxy api:8000
    }

    handle {
        reverse_proxy api:8000
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    log {
        output stdout
        format json
    }
}
