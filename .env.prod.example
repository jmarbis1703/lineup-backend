# ── Production environment — copy to .env.prod and fill in real values ─────────
# Generate secrets with: openssl rand -hex 32

# ── Domain ─────────────────────────────────────────────────────────────────────
DOMAIN=api.yourdomain.com
TLS_EMAIL=you@yourdomain.com

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=lineup
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=lineup
# DATABASE_URL is constructed by docker-compose.prod.yml — do not set here

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_redis_password_here
# REDIS_URL is constructed by docker-compose.prod.yml — do not set here

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ── Sportmonks ─────────────────────────────────────────────────────────────────
SPORTMONKS_API_TOKEN=your_sportmonks_api_token_here
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football
