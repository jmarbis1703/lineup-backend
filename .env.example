# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=lineup
POSTGRES_PASSWORD=lineup_secret
POSTGRES_DB=lineup
# Full async DSN (used by SQLAlchemy + Alembic)
DATABASE_URL=postgresql+asyncpg://lineup:lineup_secret@db:5432/lineup
# Sync DSN for Alembic offline migrations
DATABASE_URL_SYNC=postgresql+psycopg2://lineup:lineup_secret@db:5432/lineup

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Auth ───────────────────────────────────────────────────────────────────────
SECRET_KEY=replace-me-with-a-strong-random-secret-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Sportmonks ─────────────────────────────────────────────────────────────────
# European Plan — https://www.sportmonks.com/football-api/
SPORTMONKS_API_TOKEN=your_sportmonks_api_token_here
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football

# ── League IDs (read-only reference) ──────────────────────────────────────────
# Premier League: 8 | La Liga: 564 | Serie A: 384 | Bundesliga: 82 | Ligue 1: 301
