# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=lineup
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=lineup
# Full async DSN (used by SQLAlchemy + Alembic)
DATABASE_URL=postgresql+asyncpg://lineup:your_postgres_password_here@localhost:5432/lineup
# Sync DSN for Alembic offline migrations
DATABASE_URL_SYNC=postgresql://lineup:your_postgres_password_here@localhost:5432/lineup

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Used by docker-compose.prod.yml to interpolate ${REDIS_PASSWORD} in the URL
REDIS_PASSWORD=your_redis_password_here

# ── Auth ───────────────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
# Copy from Clerk Dashboard → Webhooks → Signing Secret (starts with whsec_)
CLERK_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
# JWT_SECRET — DEPRECATED: app uses Clerk RS256, not HS256.
# Remove this line if present in your actual .env
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Sportmonks ─────────────────────────────────────────────────────────────────
# European Plan — https://www.sportmonks.com/football-api/
SPORTMONKS_API_TOKEN=your_sportmonks_api_token_here
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Must be set to the real domain in production.
# Example for production: ALLOWED_ORIGINS=https://lineup.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# ── League IDs (read-only reference) ──────────────────────────────────────────
# Premier League: 8 | La Liga: 564 | Serie A: 384 | Bundesliga: 82 | Ligue 1: 301

# ── LMSR Market Stability — Dynamic b Floor ────────────────────────────────────
# Controls price sensitivity at different user counts.
# See README "LMSR Dynamic b Floor" section for full details and removal criteria.
# Formula: B_FLOOR = LMSR_B_BASE * max(1, LMSR_N_TARGET / max(LMSR_N_MIN, n_users))
#          b_effective = max(B_FLOOR, b_min + alpha * volume)
# At 5 users → b_effective = 200,000 (~0.05% per 100pt trade)
# At 100 users → b_effective = 10,000 (~1.00% per 100pt trade)  ← anchor point
LMSR_B_BASE=10000
LMSR_N_TARGET=100
LMSR_N_MIN=5

# ── Debug ───────────────────────────────────────────────────────────────────────
# Set to true in development to enable /docs and /redoc Swagger UI.
# Never set true in production.
DEBUG=true
